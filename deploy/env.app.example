# reg-factory 服务器运行配置（容器首次启动时生成到 /data/.env）
#
# 规则：进程环境变量优先于本文件。docker-compose 的 environment 里
# 不要重复设置这里的键，否则面板里改了不会生效（只有代理类 *_PROXY_MODE
# 属于运行期热更新键，例外）。
#
# 改完保存即可对新任务生效，不需要重启容器（面板「环境配置」页同理）。

# ---------------- 浏览器 ----------------
# bundled = 容器内置 Playwright Chromium（默认，无需外部指纹浏览器）
# cloak   = Cloak 原生指纹内核（需要 INSTALL_CLOAK=1 构建 + license）
# bitbrowser / adspower / roxy = 本机指纹浏览器 API，容器部署不适用
FINGERPRINT_BROWSER=bundled
REG_FACTORY_BROWSER_PATH=/usr/local/bin/chromium
# 0 = 走 Xvfb 有头运行（更抗 Cloudflare/Arkose 检测，默认）；1 = 纯无头
REG_FACTORY_BROWSER_HEADLESS=0
# 容器内以非 root 跑 + 关闭 Chromium 自带 sandbox（容器本身即隔离边界）；
# /dev/shm 小于 512MB 时 --disable-dev-shm-usage 必须保留。
# 下面这组是 SG 实测最优（2026-10-31，arm64）：
#   空载 714MB -> 634MB，打开 claude.ai 后 1361MB -> 1302MB
#   --renderer-process-limit=2 防止单实例开多标签膨胀（=1 更省但多标签会共进程）
#   --no-zygote 单独使用无收益，已去掉；--in-process-gpu 在 Xvfb 下会崩，禁用
REG_FACTORY_BROWSER_ARGS=--no-sandbox --disable-dev-shm-usage --disable-gpu --js-flags=--max-old-space-size=256 --renderer-process-limit=2 --disable-background-networking --disable-breakpad --disable-component-update --disable-default-apps --disable-sync --no-first-run --no-default-browser-check --disable-extensions

# ---------------- 网络出口 ----------------
# SG 生产机实测（2026-10-31，出口 140.245.54.144）：
#   claude.ai        -> 403 Cloudflare "Just a moment"
#   chatgpt.com      -> 403
#   grok.com         -> 403
#   login.live.com   -> 200（Outlook 链路可直连）
#   accounts.google.com -> 302（Google 登录入口可达）
# 结论：机房 IP 跑 Claude/ChatGPT/Grok 注册必须挂住宅代理，先跑
#   deploy/proxy-check.sh 体检代理池，再开任务。
PROXY_MODE=residential
REG_FACTORY_PROXY=
REG_FACTORY_PROXY_POOL=
# 可选：代理供应商换 IP 接口
REG_FACTORY_PROXY_ROTATE_URL=
REG_FACTORY_PROXY_ROTATE_METHOD=GET
# 每平台继承全局出口
OUTLOOK_PROXY_MODE=inherit
CLAUDE_PROXY_MODE=inherit
CHATGPT_PROXY_MODE=inherit
GROK_PROXY_MODE=inherit
KIRO_PROXY_MODE=inherit
GITHUB_PROXY_MODE=inherit
# Claude 全流程必须同一出口 IP（住宅代理需用黏性会话端点）
CLAUDE_ALLOW_ROTATING_PROXY=false
# 单任务最大并发；甲骨文 2C8G 建议 2-3，4C24G 可以上到 6-8
REG_FACTORY_MAX_CONCURRENCY=3
REG_FACTORY_ALLOW_SHARED_EGRESS=false
REG_FACTORY_RESIDENTIAL_TRAFFIC_MODE=balanced

# ---------------- 面板 / 资产 API ----------------
# 留空时 entrypoint 会自动生成一个，保存在 /data/runtime/asset-api-key.txt
REG_FACTORY_ASSET_API_KEY=

# ---------------- 附加服务 ----------------
# K12 控制台需要 Node 构建产物，服务器默认不启动
K12_AUTO_START=0

# ---------------- 邮箱与接码（按需填写） ----------------
# 以你实际购买的服务为准，键名见仓库 .env.example
YYDS_API_BASE=
YYDS_API_KEY=
ICLOUD_MAIL_API_BASE=
ICLOUD_MAIL_API_KEY=
SMSMAN_TOKEN=
