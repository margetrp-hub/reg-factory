# reg-factory 服务器部署变量（docker compose 读取本文件）
#
# cp .env.server.example .env 之后改 REG_FACTORY_PANEL_PASSWORD。
# 这些变量只影响容器启动与面板鉴权；注册业务配置在 /data/.env（首次启动生成）。

# ---------------- 面板登录 ----------------
REG_FACTORY_PANEL_USER=admin
# 至少 16 位，建议 openssl rand -base64 24
REG_FACTORY_PANEL_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# 仅内网自用/做压测时置 1 可关闭登录页（公网绝对不要）
REG_FACTORY_ALLOW_ANONYMOUS=0
# auto = 按请求协议判断；走 Caddy/Nginx HTTPS 时保持 auto
REG_FACTORY_COOKIE_SECURE=auto

# ---------------- 端口发布 ----------------
# 默认只监听本机，由 Caddy/Nginx 反代并负责 HTTPS。
# 想直接 http://IP:8799 访问就改成 "8799:8799"，并确认密码足够强。
RF_PUBLISH=127.0.0.1:8799

# ---------------- 系统 ----------------
TZ=Asia/Singapore

# ---------------- 构建参数 ----------------
# 1 = 额外安装 CloakBrowser 指纹内核（需要 CLOAK_LICENSE_KEY，镜像更大）
INSTALL_CLOAK=0
# 国内/新加坡构建加速，可填 mirrors.tuna.tsinghua.edu.cn 之类
APT_MIRROR=
PIP_INDEX_URL_ARG=
REG_FACTORY_IMAGE=reg-factory:server
